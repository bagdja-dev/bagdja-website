# Endpoint API backend (server-side & build-time fetch)
NEXT_PUBLIC_API_URL=http://localhost:5003

# Domain platform untuk web renderer publik (tenant sites di {slug}.sites.bagdja.com).
# Dipakai middleware.ts (host-based tenant resolution) + canonical/OG.
# BEDA dari website.bagdja.com yang dipakai admin CMS — sengaja dipisah supaya
# subdomain tenant tidak nempel di domain admin.
# Juga menentukan suffix `Domain` cookie sesi (site_token/site_user, lihat
# lib/session.ts) untuk request non-lokal — TAPI kode sudah robust terhadap
# nilai ini kalau dijalankan di localhost/127.0.0.1 (domain attribute
# di-skip otomatis), jadi TIDAK perlu diganti ke localhost untuk dev lokal.
NEXT_PUBLIC_PLATFORM_URL=https://sites.bagdja.com

# ─── SSO Bagdja (W1 auth renderer) ─────────────────────────────────────
# SSO Bagdja untuk login buyer di renderer publik. Client app: reuse
# bagdja-website (keputusan W1) — redirect URI renderer harus
# ditambahkan ke oauthRedirectUris client tsb di bagdja-auth.
NEXT_PUBLIC_AUTH_URL=http://localhost:4001
NEXT_PUBLIC_CLIENT_ID=bagdja-website
NEXT_PUBLIC_REDIRECT_URI=http://localhost:5005/auth/callback
OAUTH_CLIENT_SECRET=change-me
# Redis biasa (self-hosted, mis. Coolify) — penyimpanan code_verifier OAuth.
# redis:// untuk plain, rediss:// untuk TLS.
REDIS_URL=redis://localhost:6379

# ─── S8: pratinjau halaman di editor Studio ────────────────────────────
# Origin admin (Studio) yang boleh menyematkan route preview
# `/{slug}/__preview` (lokal) / `https://{slug}.<platform>/__preview` dalam
# iframe dan bertukar pesan protokol preview v1. Dipisah koma bila lebih dari
# satu (mis. domain admin production + preview deployment). Hanya origin
# (scheme://host[:port]), tanpa path. Dipakai header CSP `frame-ancestors`
# (next.config.js) dan validasi origin postMessage. Kosong: dev →
# http://localhost:5004; production → preview tidak bisa disematkan.
# Nilai dibaca saat build (output standalone) — set juga sebagai build env.
NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:5004

# ─── Fase 2: runtime package template SSR (gated, server-side only) ───
# Website tanpa pin versi tetap memakai renderer built-in.
# Jika pin aktif, runtime yang tidak dikonfigurasi/gagal akan menampilkan error (tanpa fallback).
# Runtime tidak boleh menerima auth platform, cookie, atau data rahasia tenant.
TEMPLATE_RUNTIME_URL=http://127.0.0.1:5012
TEMPLATE_RUNTIME_TOKEN=change-me
TEMPLATE_RUNTIME_TIMEOUT_MS=5000
TEMPLATE_RUNTIME_ENABLED=false
# Dev-only: show an SSR artifact in the Store Classic Studio demo preview.
TEMPLATE_RUNTIME_STUDIO_PREVIEW_ENABLED=false
# Optional deployment pin: if a slug is listed, its website pin must match this exact version.
# Published registry entries and each website's stored exact version are otherwise authoritative.
TEMPLATE_RUNTIME_VERSION_MAP={}
# Optional emergency switch. Browser bundles in published artifacts run inside the existing
# opaque sandboxed iframe and CSP; no extra per-template JavaScript allowlist is required.
TEMPLATE_RUNTIME_CLIENT_BUNDLE_ENABLED=true
# Rahasia HMAC untuk `key` opaque di props.page halaman sistem template (keputusan E1).
# WAJIB di production (render gagal tanpa nilai ini); di development dibuat acak per proses.
TEMPLATE_PAGE_KEY_SECRET=
